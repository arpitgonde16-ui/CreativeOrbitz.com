# ═══════════════════════════════════════════════════════════════════
# CREATIVEORBITZ PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ═══════════════════════════════════════════════════════════════════

# 1. Supabase Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Key is strictly for serverless API endpoints (/api/*).
# NEVER expose this key in client-side / browser code or commit it to GitHub.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 2. Email Notifications (Optional - e.g. Resend, SendGrid, or custom SMTP)
# If provided, internal alert emails will be dispatched automatically upon new lead submission.
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=creativeorbitzz@gmail.com
FROM_EMAIL=notifications@creativeorbitz.com

# 3. Server Configuration (Local / Container)
PORT=3000
NODE_ENV=production
